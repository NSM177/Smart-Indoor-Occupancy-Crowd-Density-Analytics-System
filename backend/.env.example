# ============================================================================
# PYTHON FASTAPI BACKEND CONFIGURATION (.ENV.EXAMPLE)
# ============================================================================

# --- Server & Environment ---
APP_NAME=Smart Indoor Occupancy & Crowd Density Analytics Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL Database (SQLAlchemy 2.0) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=occupancy_admin
POSTGRES_PASSWORD=occupancy_secret_pwd
POSTGRES_DB=smart_occupancy_db
# Optional explicit DATABASE_URL override (e.g. postgresql+psycopg2://... or sqlite:///./smart_occupancy.db)
DATABASE_URL=

# --- JWT Authentication & RBAC ---
JWT_SECRET_KEY=smart_occupancy_super_secret_jwt_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Seed Accounts
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_OPERATOR_USERNAME=operator
DEFAULT_OPERATOR_PASSWORD=Operator@123

# --- Eclipse Mosquitto MQTT Broker ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=smart_occupancy_py_backend

# --- External AI Service & Persistence Intervals ---
AI_SERVICE_URL=http://localhost:8000
OCCUPANCY_LOG_INTERVAL_SEC=5
DEVICE_OFFLINE_TIMEOUT_SEC=35

# --- Initial Room Seed Configuration ---
INITIAL_ROOM_CODE=room1
INITIAL_ROOM_NAME=Main Conference & Exhibition Hall
INITIAL_ROOM_AREA_SQM=120.0
INITIAL_ROOM_MAX_CAPACITY=60
INITIAL_CAMERA_NAME=Primary Overhead Camera 01
INITIAL_CAMERA_STREAM_URL=0
IOT_DEVICE_ID=RPI_NODE_01
