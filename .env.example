# ============================================================================
# SMART INDOOR OCCUPANCY & CROWD DENSITY ANALYTICS SYSTEM - ROOT .ENV.EXAMPLE
# ============================================================================

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=occupancy_admin
POSTGRES_PASSWORD=occupancy_secret_pwd
POSTGRES_DB=smart_occupancy_db

# --- Eclipse Mosquitto MQTT Broker ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=smart_occupancy

# --- NestJS Backend Service ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Interval (in seconds) to persist occupancy telemetry snapshots into PostgreSQL
OCCUPANCY_LOG_INTERVAL_SEC=5
# Default seed room configuration (applied only when database is empty)
INITIAL_ROOM_NAME=Main Conference & Exhibition Hall
INITIAL_ROOM_AREA_SQM=120.0
INITIAL_ROOM_MAX_CAPACITY=60
INITIAL_CAMERA_NAME=Primary Overhead Camera 01
INITIAL_CAMERA_STREAM_URL=0

# --- AI Computer Vision Service (FastAPI + YOLO + ByteTrack) ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_PUBLIC_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:4000/api/v1
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
BYTETRACK_TRACK_BUFFER=30
HEATMAP_GRID_WIDTH=64
HEATMAP_GRID_HEIGHT=36
HEATMAP_DECAY_FACTOR=0.96
TELEMETRY_PUBLISH_INTERVAL_SEC=1.0

# --- IoT Service (Raspberry Pi Edge Agent) ---
IOT_DEVICE_ID=RPI_NODE_01
IOT_DEVICE_NAME=Raspberry Pi 5 Edge Controller
GPIO_PIN_LED_GREEN=17
GPIO_PIN_LED_YELLOW=27
GPIO_PIN_LED_RED=22
GPIO_PIN_BUZZER=23
IOT_HEARTBEAT_INTERVAL_SEC=10

# --- Next.js Frontend Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
