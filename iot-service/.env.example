# ============================================================================
# RASPBERRY PI 4/5 IOT EDGE MODULE CONFIGURATION (.ENV.EXAMPLE)
# ============================================================================

# --- MQTT Broker (Eclipse Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE_SEC=30
MQTT_RECONNECT_MIN_SEC=1
MQTT_RECONNECT_MAX_SEC=30

# --- Device & Room Identification ---
IOT_DEVICE_ID=RPI_NODE_01
IOT_DEVICE_NAME=Raspberry Pi 5 Edge Controller
IOT_ROOM_ID=room1

# --- Approved BCM GPIO Pin Mapping (40-Pin Header J8) ---
# LED Green  -> BCM GPIO 17 (Physical Pin 11)
# LED Yellow -> BCM GPIO 27 (Physical Pin 13)
# LED Red    -> BCM GPIO 22 (Physical Pin 15)
# Buzzer     -> BCM GPIO 23 (Physical Pin 16)
GPIO_PIN_LED_GREEN=17
GPIO_PIN_LED_YELLOW=27
GPIO_PIN_LED_RED=22
GPIO_PIN_BUZZER=23

# --- Simulation & Hardware Mode ---
# Set SIMULATION_MODE=true to force simulation mode on any machine.
# When false, automatically uses physical Raspberry Pi GPIO if available, or falls back to Simulation.
SIMULATION_MODE=false

# --- Occupancy & Density Thresholds (Fallback when message only contains raw numbers) ---
ROOM_MAX_CAPACITY=60
WARNING_OCCUPANCY_RATIO=0.80
WARNING_DENSITY_THRESHOLD=0.35
CRITICAL_DENSITY_THRESHOLD=0.50
BUZZER_MAX_DURATION_SEC=15

# --- Camera & AI Service Connection ---
CAMERA_ENABLED=true
CAMERA_SOURCE=0
CAMERA_STREAM_PORT=8081
AI_SERVICE_URL=http://localhost:8000

# --- Heartbeat, Watchdog & Logging ---
IOT_HEARTBEAT_INTERVAL_SEC=10
WATCHDOG_CHECK_INTERVAL_SEC=5
TELEMETRY_STALE_TIMEOUT_SEC=60
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/iot_device.log
